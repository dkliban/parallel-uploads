def setup_logging() -> logging.Logger:
    logFormatter = logging.Formatter("%(asctime)s - %(filename)s - %(levelname)s - %(message)s")
    logger = logging.getLogger()
    logger.setLevel(logging.DEBUG)

    # Add a console handler
    consoleHandler = logging.StreamHandler()
    consoleHandler.setFormatter(logFormatter)
    logger.addHandler(consoleHandler)

    # Add a file handler
    fileHandler = logging.FileHandler("upload-to-pulp.log")
    fileHandler.setFormatter(logFormatter)
    logger.addHandler(fileHandler)

    return logger


logger = setup_logging()

def create_from_config_file(path=None):
    """
    Create a Pulp client from a standard configuration file that is
    used by the `pulp` CLI tool
    """
    path = os.path.expanduser(path or "~/.config/pulp/cli.toml")
    with open(path, "rb") as fp:
        config = tomllib.load(fp)["cli-prod"]
        configuration = Configuration()
        #import pdb; pdb.set_trace()
        configuration.host = config["base_url"]
        #configuration.username = config["username"]
        #configuration.password = config["password"]
        configuration.cert_file = config["cert"]
        configuration.key_file = config["key"]
        configuration.domain = config["domain"]
        configuration.proxy = os.environ.get("HTTPS_PROXY")

    return configuration


def packages(source_dir):
    """
    Generator that yields package names from a source directory.
    """

    for root, _, files in os.walk(source_dir):
        for filename in files:
            if filename.endswith(".rpm") or filename.endswith(".srpm"):
                yield os.path.join(root, filename)

def monitor_task(configuration, task_href):
    """
    Wait for a task to complete.
    """
    pulpcore_api_client = pulpcore_client.ApiClient(configuration)
    task_client = TasksApi(pulpcore_api_client)
    print(f"Waiting for task {task_href} to complete...")
    while True:
        task = task_client.read(task_href)
        if task.state in ["completed", "cancelled", "failed"]:
            return task
        time.sleep(5)

def upload_package_in_chunks(
    client: pulpcore_client.ApiClient,
    path: str,
    max_chunk_size: int,
    file_size_bytes: int,
    labels: dict[str, str],
) -> pulp_rpm_client.models.RpmPackageResponse:
    """
    Upload a python build artifact in chunks to a Pulp server with the given labels.
    """
    uploads_api = UploadsApi(client)

    # we create the upload object and tell pulp the chunked upload is happening
    upload = Upload(size=file_size_bytes)
    upload_res = uploads_api.create(upload, pulp_domain=client.configuration.domain)

    logger.info(f"Starting upload of file '{path}' to pulp in chunks...")
    sha256_chunks = hashlib.sha256()
    start = 0

    with open(path, "rb") as f:
        while chunk := f.read(max_chunk_size):
            end = start + len(chunk) - 1

            logger.info(f"Uploading bytes from chunk {start}-{end}.")
            uploads_api.update(content_range=f"bytes {start}-{end}/*",
                               upload_href=upload_res.pulp_href,
                               file=chunk)
            sha256_chunks.update(chunk)

            start = end + 1

    logger.info(f"Committing upload of file '{path}' to pulp in chunks...")
    # we create a UploadCommit object and tell pulp it can close the upload process
    upload_commit = UploadCommit(
        sha256=sha256_chunks.hexdigest()
    )

    async_task_res = uploads_api.commit(upload_href=upload_res.pulp_href, upload_commit=upload_commit)
    task_res = monitor_task(client.configuration, async_task_res.task)

    if task_res.error:
        raise ValueError(f"Error uploading file '{path}' to pulp: {task_res.error}")

    artifact_prn = task_res.created_resources[0]

    logger.info(f"File '{path}' created as an artifact in pulp with PRN: {artifact_prn}")
    logger.info(f"Converting PULP artifact with PRN '{artifact_prn}' to a python package...")
    # when an artifact is created in pulp through chunked upload it is not immidiatly
    # identified as a python package so we need to tell pulp to create a python package from the artifact
    content_api_client = pulp_rpm_client.ApiClient(client.api.configuration)
    content_client = ContentPackagesApi(content_api_client)
    content_task_res = content_client.create(
        relative_path=str(os.path.basename(path)),
        artifact=artifact_prn,
        pulp_domain=client.configuration.domain,
    )

    task_res = monitor_task(client.configuration, content_task_res.task)

    package_prn = task_res.created_resources[0]

    if task_res.error:
        raise ValueError(f"Error during adding file '{path}' as a python package in pulp: {task_res.error}")

    content_details = content_client.read(python_python_package_content_href=package_prn)

    logger.info(f"File '{path}' converted to a python package in pulp with PRN: {content_details.prn}")

    # if labels are provided, we need to set them for the python package
    if labels:
        logger.info(f"Setting labels for uploaded python package '{path}'...")
        for key, value in labels.items():
            content_client.set_label(
                python_python_package_content_href=content_details.pulp_href,
                set_label=pulpcore.client.pulp_python.models.SetLabel(key=key, value=value),
            )

    logger.info(f"Uploading of file '{path}' to pulp in chunks completed.")

    return content_details


def upload_rpm(client, filepath, labels):
    """Upload a single RPM and return its PRN."""
    package_client = ContentPackagesApi(client)
    domain = client.configuration.domain
    try:
        package = package_client.upload(file=filepath, pulp_labels=labels, pulp_domain=domain)
    except RpmApiException as e:
        print(f"Failed to upload {filepath}. {e.body}")
        return None
    return package.prn

def ensure_repository(client, name):
    """Try to create repo, else fetch if already exists."""
    repo_client = RepositoriesRpmApi(client)
    data = RpmRpmRepository(name=name, autopublish=True)
    domain = client.configuration.domain
    try:
        repo = repo_client.create(data, pulp_domain=domain)
    except RpmApiException as e:
        if "name" in e.body and "unique" in e.body:
            repo_list = repo_client.list(name=name, pulp_domain=domain)
            if repo_list.results:
                repo = repo_list.results.pop()
            else:
                # A different type of repository already exists with this name
                raise e
        else:
            raise e
    return repo

def ensure_distribution(client, name, repo_href, base_path):
    """Try to create distribution, else fetch if already exists."""

    distro_client = DistributionsRpmApi(client)
    data = RpmRpmDistribution(name=name, repository=repo_href, base_path=base_path)
    domain = client.configuration.domain
    try:
        distro_response = distro_client.create(data, pulp_domain=domain)
        task = monitor_task(client.configuration, distro_response.task)
        return task.created_resources[0]
    except RpmApiException as e:
        if "name" in e.body and "unique" in e.body:
            distro_list = distro_client.list(name=name, pulp_domain=domain)
            distro = distro_list.results.pop()
        else:
            raise e
    return distro

def add_packages_to_repository(client, repository, packages):
    """
    Creates a new repository version by adding packages to the repository.
    """
    import pdb;pdb.set_trace()
    repo_client = RepositoriesRpmApi(client)
    response = repo_client.modify(rpm_rpm_repository_href=repository.pulp_href, repository_add_remove_content={"add_content_units":packages, "remove_content_units":None})
    print(f"Repository Version Create Task: {response.task}")
    task = monitor_task(client.configuration, response.task)
    print(f"Repository Version Task State: {task.state}")

def main():
    import os
    import pdb;pdb.set_trace(
    )
    if len(sys.argv) != 5:
        print(f"Usage: {sys.argv[0]} <source_dir> <repo_name> <base_path> <pulp_labels_json>")
        sys.exit(1)

    source_dir, repo_name, base_path, labels_arg = sys.argv[1:5]

    try:
        pulp_labels = json.loads(labels_arg)
        if not isinstance(pulp_labels, dict):
            raise ValueError("pulp_labels must be a JSON object")
    except json.JSONDecodeError:
        print("Error: pulp_labels must be valid JSON (e.g. '{\"env\":\"prod\"}')")
        sys.exit(1)

    if not os.path.isdir(source_dir):
        print(f"Error: {source_dir} is not a valid directory.")
        sys.exit(1)

    configuration = create_from_config_file()
    pulpcore_api_client = pulpcore_client.ApiClient(configuration)
    pulp_rpm_api_client = pulp_rpm_client.ApiClient(configuration)


    # --- Step 1: Ensure repository ---
    repo = ensure_repository(pulp_rpm_api_client, repo_name)

    # --- Step 2: Ensure distribution ---
    dist_href = ensure_distribution(pulp_rpm_api_client, repo_name, repo.pulp_href, base_path)

    # --- Step 4: Upload RPMs in parallel ---
    with ThreadPoolExecutor(max_workers=10) as executor:
        prns = []
        futures = []
        # Walk source directory
        for f in packages(source_dir):
            futures.append(executor.submit(upload_rpm, pulp_rpm_api_client, f, pulp_labels))

        for future in as_completed(futures):
            prn = future.result()
            if prn:
                prns.append(prn)
                #print(f"Uploaded: {[future]} -> {prn}")

    print(f"Uploaded {len(prns)} RPMs successfully")

    # --- Step 5: Add uploaded content to repository ---
    if prns:
        print("Adding content to repository...")
        task = add_packages_to_repository(pulp_rpm_api_client, repo, prns)

    print("✅ All done!")

if __name__ == "__main__":
    main()